# Copier vers .env (jamais commité). Générer les secrets :
#   openssl rand -base64 48

POSTGRES_DB=dibidani
POSTGRES_USER=dibidani
POSTGRES_PASSWORD=change_me_with_a_strong_password

# Minimum 32 octets.
JWT_SECRET=replace_with_at_least_32_random_bytes

# Origines du navigateur (production : https://dibidani.ml uniquement).
CORS_ORIGINS=http://localhost,http://localhost:80
PUBLIC_URL=http://localhost

# Ports publiés sur la machine hôte (internes inchangés).
FRONTEND_PORT=80
BACKEND_HOST_PORT=8080
POSTGRES_HOST_PORT=5434

# Images Docker (Jenkins renseigne le tag ; laisser :local = build Compose).
BACKEND_IMAGE=dibidani-backend:local
FRONTEND_IMAGE=dibidani-frontend:local

# Développement : true. Production : false (voir docker-compose.prod.yml).
SEED_DEMO_DATA=true
PAYMENT_MOCK_ENABLED=true
PAYMENT_MOCK_WEBHOOK_SECRET=replace_with_a_random_secret

ORANGE_MONEY_BASE_URL=https://api.orange.com
ORANGE_MONEY_WEBPAY_PATH=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CURRENCY=XOF

MOOV_MONEY_BASE_URL=
MOOV_MONEY_INITIATE_PATH=
MOOV_MONEY_MERCHANT_ID=
MOOV_MONEY_API_KEY=
MOOV_MONEY_WEBHOOK_SECRET=

SHOP_PHONE=+223 76 12 34 56
SHOP_WHATSAPP=+223 76 12 34 56
SHOP_FACEBOOK_URL=https://www.facebook.com/dibidani
SHOP_TIKTOK_URL=https://www.tiktok.com/@dibidani
SHOP_EMAIL=contact@dibidani.ml
SOCIAL_MOCK_ENABLED=true
AUTH_OAUTH_MOCK_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PUBLISH_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# E-mail OTP (SMTP, ex. SendGrid : smtp.sendgrid.net / apikey / SG.xxx)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=contact@dibidani.ml
MAIL_FROM_NAME=Dibidani
MAIL_MOCK_ENABLED=true

# SMS Gateway for Android (https://sms-gate.app)
SMS_GATEWAY_BASE_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_DEVICE_ID=
SMS_GATEWAY_SIM_NUMBER=
SMS_GATEWAY_MOCK_ENABLED=true
SHOP_ADDRESS=Marché de Dibidani, Commune III
SHOP_OPENING_HOURS=Lun - Sam, 8h - 20h
